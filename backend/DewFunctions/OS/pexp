#!/usr/bin/perl
# Get proj, exp or node name. Run on exp node.
# Specify -p for project name or -e for exp name
# or -n for node name
# pexp -p|-e|-n

$mode = "eth";
$intf = "exp";
$node = "";

$usage="$0 -p|-e|-n\n";

$mode = "";

if ($#ARGV < 0)
{
    print $usage;
    exit 0;
}
$mode = $ARGV[0];
$mode =~ s/\-//;

open(HN, "hostname |");
$hostname = <HN>;
@items = split /\./, $hostname;
$out = "";
$proj = "";
$exp = "";
if ($#items < 2)
{
    print "";
}
else
{
    $proj = $items[2];
    $exp = $items[1];
    
    if($mode eq "p")
    {
	$out = $items[2];
    }
    elsif($mode eq "e")
    {
	$out = $items[1];
    }
    elsif($mode eq "n")
    {
	print $items[0];
    }
    else
    {
	print "";
    }
}
# Fix capitalization from OS
if ($out ne "")
{
    if ($mode eq "p" || $mode eq "e")
    {
	open(LS, "ls /proj |");
	while(<LS>)
	{
	    $p = $_;
	    $p =~ s/\n//;
	    if (lc($p) eq $proj)
	    {
		if ($mode eq "e")
		{
		    open(LSE, "ls /proj/$p/exp/ |");
		    while(<LSE>)
		    {
			$e = $_;
			$e =~ s/\n//;
			if (lc($e) eq $exp)
			{
			    print $e;
			}
		    }
		}
		else
		{
		    print $p;
		}
	    }
	}
    }
}
