import os.path
import sys
import re

cwd = os.path.dirname(os.path.realpath(__file__))
parentDir = os.path.abspath(os.path.join(cwd, os.pardir))
sys.path.insert(0, parentDir)
from generator import Generator

class NSGenerator(Generator):
    
    def __init__(self, *args, **kwargs):
        super().__init__(*args, name="ns", **kwargs)
        self.evars = [];

    def generate(self):
        super().generate()

        self.collectNum()
        self.generatePreamble()        
        self.generateNS()
        self.generatePostamble()        

    def collectNum(self):
        self.num = dict()
        for c in self.constraints_parsed:
            if c[0] == 'num':
                self.num[c[1][0]] = int(c[2][0])
            
    def generateNS(self):

        
        # Collect all actors
        actors = dict()
        os = dict()
        links = dict()
        for s in self.scenario_parsed:
            actors[s[1][0]] = 1

        # Collect OS constraints
        for c in self.constraints_parsed:
            if c[0] == 'os':
                os[c[1][0]] = c[2][0]

        # Collect link constraints
        cl = 0
        lans = dict()
        links = dict()
        for c in self.constraints_parsed:
            if c[0] == 'link':
                a = c[1][0]
                b = c[1][1]
                if a not in links.keys() and b not in links.keys():
                    links[a] = dict()
                    links[a][b] = 1
                elif a in links.keys():
                    links[a][b] = 1
                else:
                    links[b][a] = 1
            elif c[0] == 'lan':
                lans[cl] = []
                for n in c[1]:
                    if n in self.num.keys():
                        for i in range (1, self.num[n]+1):
                            lans[cl].append(n+"-"+str(i))
                    else:
                        lans[cl].append(n)
                cl += 1
                    
        # Generate nodes
        for a in actors:
            if a in self.num.keys():
                self.text +=  "set NODES " + str(self.num[a]) + "\n"
                self.text += "for {set i 1} {$i <= $NODES} {incr i} {\n"
                self.text += "\t set "+a+"($i) [$ns node]\n"
                if (a in os.keys()):
                    self.text += "\t tb-set-node-os [set "+a+"($i)] " + os[a] + "\n"
                else:
                    self.text += "\t tb-set-node-os [set "+a+"($i)] Ubuntu-DEW\n"
                self.text += "}\n"
            else:
                self.text += "set "+a+" [$ns node]\n"
                if (a in os.keys()):
                    self.text += "tb-set-node-os "+a+" "+ os[a] + "\n"

        # Generate links 
        cnt = 1
        for a in links.keys():
            if a in self.num.keys():
                for i in range (1, self.num[a]+1):
                    for b in links[a].keys():
                        if b in self.num.keys():
                            for j in range (1,self.num[b]+1):
                                self.text += "set link"+str(cnt)+" [$ns duplex-link "+a+"-"+str(i)+" "+b+"-"+str(j)+" 100Mb 0ms DropTail]\n"
                                cnt += 1
                        else:
                            self.text += "set link"+str(cnt)+" [$ns duplex-link "+a+"-"+str(i)+" "+b+" 100Mb 0ms DropTail]\n"
                            cnt += 1
            else:
                 for b in links[a].keys():
                     if b in self.num.keys():
                         for j in range (1,self.num[b]+1):
                               self.text += "set link"+str(cnt)+" [$ns duplex\
-link "+a+" "+b+"-"+str(j)+" 100Mb 0ms DropTail]\n"
                               cnt += 1
                     else:
                         self.text += "set link"+str(cnt)+" [$ns duplex-link "+a+" "+b+" 100Mb 0ms DropTail]\n"
                         cnt += 1
        # Generate lans
        for l in lans.keys():
            self.text += "set lan"+str(l)+" [$ns make-lan \""
            for n in lans[l]:
                self.text += n+ " "
            self.text += "\" 100Mb 0.0ms]\n"
            
    def generatePreamble(self):
        self.text += open('ns/ns_preamble.txt', 'r').read()

    def generatePostamble(self):
        self.text += open('ns/ns_postamble.txt', 'r').read()

    def parse(self):
        print("Parsing NS")
        super().parse()



